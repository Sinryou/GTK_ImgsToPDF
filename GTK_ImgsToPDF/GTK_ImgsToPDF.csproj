<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <Copyright>Copyright © 2026 Sinryou.</Copyright>
    <ApplicationIcon>pimejaSike.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Message Text="正在复制 Core 资源文件..." Importance="high" />
    <ItemGroup>
      <SourceAssets Include="$(ProjectDir)Core\**\*.*" />
    </ItemGroup>
    <Copy 
      SourceFiles="@(SourceAssets)" 
      DestinationFiles="$(TargetDir)Core\%(RecursiveDir)%(Filename)%(Extension)" 
      SkipUnchangedFiles="true" 
      OverwriteReadOnlyFiles="true" />
      <!-- SkipUnchangedFiles 对应增量更新，OverwriteReadOnlyFiles 对应 /R -->
  </Target>

  <ItemGroup>
    <Compile Remove="Core\**" />
    <EmbeddedResource Remove="Core\**" />
    <None Remove="Core\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="pimejaSike.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
